{
  "$description": "Imagine Cities design tokens (W3C DTCG format). Based on Imagine Cities Brand Guidelines v2.0.1, with documented website overrides from the Brand Guidelines UX Figma file.",
  "color": {
    "$type": "color",
    "$description": "Brand palette, v2.0.1 section 2. Gold is the hero colour.",
    "gold": {
      "$value": "#FFB827",
      "$description": "Hero colour. RGB 255 184 39 / CMYK 0 28 85 0."
    },
    "deep-azure": {
      "$value": "#0656BF",
      "$description": "RGB 6 86 191 / CMYK 97 55 0 25."
    },
    "serene-white": {
      "$value": "#F5F7F2",
      "$description": "RGB 245 247 242 / CMYK 1 0 2 3."
    },
    "charcoal-black": {
      "$value": "#242525",
      "$description": "RGB 36 37 37 / CMYK 3 0 0 85."
    },
    "forest-green": {
      "$value": "#527302",
      "$description": "RGB 82 115 2 / CMYK 29 0 98 55."
    },
    "fresh-green": {
      "$value": "#C6FDC2",
      "$description": "RGB 198 253 194 / CMYK 22 0 23 1."
    },
    "bold-red": {
      "$value": "#C73124",
      "$description": "RGB 199 49 36 / CMYK 0 75 82 22. Use sparingly — alerts, warnings, emphasis."
    },
    "action": {
      "$value": "{color.gold}",
      "$description": "Semantic alias. Call-to-action buttons, key icons, standout elements."
    },
    "link": {
      "$value": "{color.deep-azure}",
      "$description": "Semantic alias. Links."
    },
    "header": {
      "$value": "{color.deep-azure}",
      "$description": "Semantic alias. Headers and secondary elements."
    },
    "text": {
      "$value": "{color.charcoal-black}",
      "$description": "Semantic alias. Body and UI text."
    },
    "background": {
      "$value": "{color.serene-white}",
      "$description": "Semantic alias. Page and surface backgrounds."
    },
    "danger": {
      "$value": "{color.bold-red}",
      "$description": "Semantic alias. Alerts, warnings, errors."
    },
    "tint": {
      "$description": "Tint ramps from v2.0.1 section 2.2, for the four colours that have one: Deep Azure, Gold, Forest Green and Bold Red. Serene White, Charcoal Black and Fresh Green have no ramp. Values are explicit. The Deep Azure and Forest Green 20% stops follow Figma. Note they are mixed against Serene White #F5F7F2, not pure white — a pure-white mix drifts by up to 11 per channel at the 20% stop, so do not regenerate these by formula. The 100% stop is the base colour.",
      "deep-azure": {
        "100": { "$value": "{color.deep-azure}" },
        "80": { "$value": "#3677CA" },
        "60": { "$value": "#6697D4" },
        "40": { "$value": "#95B6DD" },
        "20": { "$value": "#C9DAF1", "$description": "Website override from the Figma Deep Azure 20% swatch. The brand deck lists #C5D6E7." }
      },
      "gold": {
        "100": { "$value": "{color.gold}" },
        "80": { "$value": "#FDC550" },
        "60": { "$value": "#FBD178" },
        "40": { "$value": "#F9DEA1" },
        "20": { "$value": "#F7EAC9", "$description": "Section background stop." }
      },
      "forest-green": {
        "100": { "$value": "{color.forest-green}" },
        "80": { "$value": "#738E33" },
        "60": { "$value": "#93A862" },
        "40": { "$value": "#B4C292" },
        "20": { "$value": "#D6DEC5", "$description": "Website override from the Figma Forest Green 20% swatch. The brand deck lists #D4DCC1." }
      },
      "bold-red": {
        "100": { "$value": "{color.bold-red}" },
        "80": { "$value": "#D0594E" },
        "60": { "$value": "#D98077" },
        "40": { "$value": "#E3A89F" },
        "20": { "$value": "#ECCFC8" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "brand": {
        "$value": ["Poppins", "sans-serif"],
        "$description": "Brand font. Use for printed materials, hard-copy client deliverables, emailed PDFs, and website copy."
      },
      "inter": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Typeface used by the Figma Desktop/Paragraph small bold style."
      },
      "system": {
        "$value": ["Roboto", "sans-serif"],
        "$description": "System fallback where Poppins is unavailable, and for client deliverables that cannot be saved as PDF."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "Weight names used by the v2.0.1 type scale, mapped to their standard CSS numeric values.",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "black": {
        "$value": 900,
        "$description": "Listed as an available Roboto weight; not assigned to any type-scale style."
      }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "The 12 desktop text styles, based on v2.0.1 and aligned with the saved Brand Guidelines UX Figma styles.",
    "title-display": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "72px",
        "lineHeight": "120%",
        "letterSpacing": "-3%"
      }
    },
    "title-page": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "48px",
        "lineHeight": "120%",
        "letterSpacing": "-2%"
      }
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "32px",
        "lineHeight": "120%",
        "letterSpacing": "0%"
      }
    },
    "headline": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "20px",
        "lineHeight": "24px",
        "letterSpacing": "-2%"
      },
      "$description": "Uses the saved Figma Desktop/Headline line height of 24px. The brand deck prints 24%."
    },
    "subheadline": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "20px",
        "lineHeight": "120%",
        "letterSpacing": "0%"
      }
    },
    "paragraph-1": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "16px",
        "lineHeight": "140%",
        "letterSpacing": "0%"
      }
    },
    "paragraph-1-bold": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "16px",
        "lineHeight": "auto",
        "letterSpacing": "0%"
      },
      "$description": "Line height documented as 'Auto' (font default)."
    },
    "paragraph-small": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "14px",
        "lineHeight": "140%",
        "letterSpacing": "0%"
      }
    },
    "paragraph-small-bold": {
      "$value": {
        "fontFamily": "{font.family.inter}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "14px",
        "lineHeight": "140%",
        "letterSpacing": "0%"
      }
    },
    "button-text": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "16px",
        "lineHeight": "150%",
        "letterSpacing": "0%"
      }
    },
    "tag": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "14px",
        "lineHeight": "auto",
        "letterSpacing": "0%"
      },
      "$description": "Line height documented as 'Auto' (font default)."
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "11px",
        "lineHeight": "auto",
        "letterSpacing": "0%"
      },
      "$description": "Line height documented as 'Auto' (font default)."
    }
  },
  "website": {
    "$description": "Website foundations observed in Brand Guidelines UX Figma. See source/observed-figma-ux.md for the source sections.",
    "spacing": {
      "4": {
        "$value": "4px"
      },
      "8": {
        "$value": "8px"
      },
      "16": {
        "$value": "16px"
      },
      "24": {
        "$value": "24px"
      },
      "48": {
        "$value": "48px"
      },
      "64": {
        "$value": "64px"
      },
      "80": {
        "$value": "80px"
      },
      "120": {
        "$value": "120px"
      },
      "$type": "dimension",
      "mobile": {
        "20": {
          "$value": "20px"
        },
        "32": {
          "$value": "32px"
        },
        "40": {
          "$value": "40px"
        },
        "$description": "Additional values specified by the mobile gap rules."
      },
      "gap": {
        "desktop": {
          "section": {
            "$value": "{website.spacing.80}"
          },
          "content": {
            "$value": "{website.spacing.64}"
          },
          "button": {
            "$value": "{website.spacing.24}"
          },
          "column": {
            "$value": "{website.spacing.24}"
          },
          "heading": {
            "$value": "{website.spacing.16}"
          }
        },
        "mobile": {
          "section": {
            "$value": "{website.spacing.mobile.40}"
          },
          "content": {
            "$value": "{website.spacing.mobile.32}"
          },
          "button": {
            "$value": "{website.spacing.mobile.20}"
          },
          "column": {
            "$value": "{website.spacing.16}"
          },
          "heading": {
            "$value": "{website.spacing.16}"
          }
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "surface": {
        "$value": "8px"
      },
      "pill": {
        "$value": "360px"
      }
    },
    "shadow": {
      "$type": "shadow",
      "ds2": {
        "$value": {
          "color": "#2425251F",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "24px",
          "spread": "0px"
        }
      },
      "ds3": {
        "$value": {
          "color": "#2425253D",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "24px",
          "spread": "0px"
        }
      }
    }
  }
}
