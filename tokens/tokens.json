{
  "$description": "Imagine Cities design tokens (W3C DTCG format). Every value is transcribed from Imagine Cities Brand Guidelines v2.0.1 (October 2024) via source/brand-v2.0.1.md. No values from the superseded 2021 Design Guidelines.pdf appear here.",
  "color": {
    "$type": "color",
    "$description": "Brand palette, v2.0.1 section 2. Gold is the hero colour.",
    "gold": {
      "$value": "#FFB827",
      "$description": "Hero colour. RGB 255 184 39 / CMYK 0 28 85 0."
    },
    "deep-azure": {
      "$value": "#0656BF",
      "$description": "RGB 6 86 191 / CMYK 97 55 0 25."
    },
    "serene-white": {
      "$value": "#F5F7F2",
      "$description": "RGB 245 247 242 / CMYK 1 0 2 3."
    },
    "charcoal-black": {
      "$value": "#242525",
      "$description": "RGB 36 37 37 / CMYK 3 0 0 85."
    },
    "forest-green": {
      "$value": "#527302",
      "$description": "RGB 82 115 2 / CMYK 29 0 98 55."
    },
    "fresh-green": {
      "$value": "#C6FDC2",
      "$description": "RGB 198 253 194 / CMYK 22 0 23 1."
    },
    "bold-red": {
      "$value": "#C73124",
      "$description": "RGB 199 49 36 / CMYK 0 75 82 22. Use sparingly — alerts, warnings, emphasis."
    },
    "action": {
      "$value": "{color.gold}",
      "$description": "Semantic alias. Call-to-action buttons, key icons, standout elements."
    },
    "link": {
      "$value": "{color.deep-azure}",
      "$description": "Semantic alias. Links."
    },
    "header": {
      "$value": "{color.deep-azure}",
      "$description": "Semantic alias. Headers and secondary elements."
    },
    "text": {
      "$value": "{color.charcoal-black}",
      "$description": "Semantic alias. Body and UI text."
    },
    "background": {
      "$value": "{color.serene-white}",
      "$description": "Semantic alias. Page and surface backgrounds."
    },
    "danger": {
      "$value": "{color.bold-red}",
      "$description": "Semantic alias. Alerts, warnings, errors."
    },
    "tint": {
      "$description": "Tint ramps from v2.0.1 section 2.2, for the four colours that have one: Deep Azure, Gold, Forest Green and Bold Red. Serene White, Charcoal Black and Fresh Green have no ramp. Values are the deck's own, not derived. Note they are mixed against Serene White #F5F7F2, not pure white — a pure-white mix drifts by up to 11 per channel at the 20% stop, so do not regenerate these by formula. The 100% stop is the base colour.",
      "deep-azure": {
        "100": { "$value": "{color.deep-azure}" },
        "80": { "$value": "#3677CA" },
        "60": { "$value": "#6697D4" },
        "40": { "$value": "#95B6DD" },
        "20": { "$value": "#C5D6E7", "$description": "Section background stop." }
      },
      "gold": {
        "100": { "$value": "{color.gold}" },
        "80": { "$value": "#FDC550" },
        "60": { "$value": "#FBD178" },
        "40": { "$value": "#F9DEA1" },
        "20": { "$value": "#F7EAC9", "$description": "Section background stop." }
      },
      "forest-green": {
        "100": { "$value": "{color.forest-green}" },
        "80": { "$value": "#738E33" },
        "60": { "$value": "#93A862" },
        "40": { "$value": "#B4C292" },
        "20": { "$value": "#D4DCC1", "$description": "Section background stop." }
      },
      "bold-red": {
        "100": { "$value": "{color.bold-red}" },
        "80": { "$value": "#D0594E" },
        "60": { "$value": "#D98077" },
        "40": { "$value": "#E3A89F" },
        "20": { "$value": "#ECCFC8" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "brand": {
        "$value": ["Poppins", "sans-serif"],
        "$description": "Brand font. Use for printed materials, hard-copy client deliverables, emailed PDFs, and website copy."
      },
      "system": {
        "$value": ["Roboto", "sans-serif"],
        "$description": "System fallback where Poppins is unavailable, and for client deliverables that cannot be saved as PDF."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "Weight names used by the v2.0.1 type scale, mapped to their standard CSS numeric values.",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "black": {
        "$value": 900,
        "$description": "Listed as an available Roboto weight; not assigned to any type-scale style."
      }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "The 12 documented type styles, v2.0.1 section 3.2. Line height and letter spacing are transcribed as percentages exactly as the deck states them. fontFamily is the brand font; substitute {font.family.system} wherever Poppins is unavailable.",
    "title-display": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "72px",
        "lineHeight": "120%",
        "letterSpacing": "-3%"
      }
    },
    "title-page": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "48px",
        "lineHeight": "120%",
        "letterSpacing": "-2%"
      }
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "48px",
        "lineHeight": "120%",
        "letterSpacing": "-2%"
      }
    },
    "headline": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "20px",
        "lineHeight": "24%",
        "letterSpacing": "-2%"
      },
      "$description": "UNVERIFIED line height: the slide reads 24%, which at 20px would render 4.8px. Transcribed verbatim rather than corrected — confirm the intended value before relying on it. Weight, size and letter spacing are confirmed from the slide."
    },
    "subheadline": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "20px",
        "lineHeight": "120%",
        "letterSpacing": "0%"
      }
    },
    "paragraph-1": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "16px",
        "lineHeight": "140%",
        "letterSpacing": "0%"
      }
    },
    "paragraph-1-bold": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "16px",
        "lineHeight": "auto",
        "letterSpacing": "0%"
      },
      "$description": "Line height documented as 'Auto' (font default)."
    },
    "paragraph-small": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "14px",
        "lineHeight": "140%",
        "letterSpacing": "0%"
      }
    },
    "paragraph-small-bold": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "14px",
        "lineHeight": "140%",
        "letterSpacing": "0%"
      }
    },
    "button-text": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "16px",
        "lineHeight": "150%",
        "letterSpacing": "0%"
      }
    },
    "tag": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "14px",
        "lineHeight": "auto",
        "letterSpacing": "0%"
      },
      "$description": "Line height documented as 'Auto' (font default)."
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "11px",
        "lineHeight": "auto",
        "letterSpacing": "0%"
      },
      "$description": "Line height documented as 'Auto' (font default)."
    }
  }
}
